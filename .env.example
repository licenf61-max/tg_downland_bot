# 把 .env 复制成 .env.example 时记得清空 Token
BOT_TOKEN=your_bot_token_here

# 所有者：授权体系最高权限。留空 = 重启后第一个 /start 的人自动成为所有者
# OWNER_ID=

# 白名单：额外放行的用户（授权体系之外的硬编码白名单），逗号分隔
ALLOWED_USER_IDS=
# 管理员 ID
ADMIN_IDS=
# 允许使用的会话 ID
ALLOWED_CHAT_IDS=
# 访问 Telegram 的代理（国内网络必须配）。留空 = 自动探测（Windows 系统代理 → 环境变量）
PROXY_URL=

# 自建本地 Bot API server
API_BASE_URL=https://api.telegram.org
# 解析 t.me 消息链接用（Telethon 用户账号，my.telegram.org 免费申请）
API_ID=
API_HASH=
# 直链下载上限（MB）
MAX_URL_SIZE_MB=2048
# 单用户配额（MB）
USER_QUOTA_MB=0
# 下载后删除原消息
DELETE_AFTER_SAVE=false
# 进度刷新间隔（秒）
PROGRESS_INTERVAL=3
# 日志级别
LOG_LEVEL=INFO
